# Copia este archivo a `.env` y descomenta/edita lo que quieras cambiar.
# Todo es opcional: si no pones nada, se usan los valores por defecto.
# El archivo se busca primero en el directorio actual y después en la raíz del proyecto.

# --- App ---
# DEFAULT_LEVEL=intermediate  # beginner, intermediate, advanced
# TARGET_LANGUAGE=en          # Idioma que practicas: en, es, fr, de, it, pt
# MAX_HISTORY_TURNS=20        # Pares pregunta/respuesta que se envían al LLM (0 = todo el historial)
# AUTO_SAVE_ON_EXIT=false     # Guardar la conversación automáticamente al salir (si no, pregunta)

# --- Whisper (reconocimiento de voz) ---
# Modelos: tiny, base, small, medium, large-v3
# WHISPER_MODEL=base
# int8 para CPU, float16 para GPU
# WHISPER_COMPUTE_TYPE=int8
# WHISPER_DEVICE=auto         # auto, cpu, cuda
# WHISPER_LANGUAGE=           # Vacío = usa TARGET_LANGUAGE. Ponlo solo si quieres forzar otro idioma

# --- Ollama (LLM) ---
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1
# OLLAMA_TIMEOUT=120
# OLLAMA_NUM_CTX=0            # Tamaño de contexto (tokens). 0 = default de Ollama. P. ej. 8192
# OLLAMA_TEMPERATURE=0.3      # Más bajo = respuestas más consistentes (y corrige mejor). -1 = default

# --- Audio ---
# SILENCE_THRESHOLD=0.01      # Sube este valor si te corta antes de tiempo en entornos ruidosos
# SILENCE_DURATION=1.5        # Segundos de silencio para terminar de grabar
# NO_SPEECH_TIMEOUT=6         # Segundos sin detectar voz antes de cancelar la grabación
# MAX_RECORD_SECONDS=30

# --- Text-to-Speech (el tutor te responde con voz) ---
# TTS_ENABLED=false
# TTS_BACKEND=auto            # auto (say en macOS, pyttsx3 en el resto), say, pyttsx3
# TTS_RATE=170                # Velocidad de la voz (palabras por minuto)
