# Copy this file to `.env` and uncomment/edit whatever you want to change.
# Everything is optional: if you set nothing, the defaults are used.
# The file is looked up first in the current directory, then in the project root.

# --- App ---
# DEFAULT_LEVEL=intermediate  # beginner, intermediate, advanced
# TARGET_LANGUAGE=en          # Language you practice: en, es, fr, de, it, pt
# MAX_HISTORY_TURNS=20        # Question/answer pairs sent to the LLM (0 = full history)
# AUTO_SAVE_ON_EXIT=false     # Save the conversation automatically on exit (otherwise it asks)

# --- Whisper (speech recognition) ---
# Models: tiny, base, small, medium, large-v3
# WHISPER_MODEL=base
# int8 for CPU, float16 for GPU
# WHISPER_COMPUTE_TYPE=int8
# WHISPER_DEVICE=auto         # auto, cpu, cuda
# WHISPER_LANGUAGE=           # Empty = uses TARGET_LANGUAGE. Set it only to force another language

# --- Ollama (LLM) ---
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1
# OLLAMA_TIMEOUT=120
# OLLAMA_NUM_CTX=0            # Context size (tokens). 0 = Ollama default. E.g. 8192
# OLLAMA_TEMPERATURE=0.3      # Lower = more consistent replies (and better corrections). -1 = default

# --- Audio ---
# SILENCE_THRESHOLD=0.01      # Raise this if it cuts you off too early in noisy environments
# SILENCE_DURATION=1.5        # Seconds of silence to stop recording
# NO_SPEECH_TIMEOUT=6         # Seconds without detecting speech before cancelling the recording
# MAX_RECORD_SECONDS=30

# --- Text-to-Speech (the tutor replies with voice) ---
# TTS_ENABLED=false
# TTS_BACKEND=auto            # auto (say on macOS, pyttsx3 elsewhere), say, pyttsx3
# TTS_RATE=170                # Voice speed (words per minute)
