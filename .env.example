# Copia este archivo a `.env` y descomenta/edita lo que quieras cambiar.
# Todo es opcional: si no pones nada, se usan los valores por defecto.

# --- Whisper (reconocimiento de voz) ---
# Modelos: tiny, base, small, medium, large-v3
# WHISPER_MODEL=base
# int8 para CPU, float16 para GPU
# WHISPER_COMPUTE_TYPE=int8
# WHISPER_LANGUAGE=en

# --- Ollama (LLM) ---
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1
# OLLAMA_TIMEOUT=120

# --- Audio ---
# SILENCE_THRESHOLD=0.01     # Sube este valor si te corta antes de tiempo en entornos ruidosos
# SILENCE_DURATION=1.5       # Segundos de silencio para terminar de grabar
# MAX_RECORD_SECONDS=30

# --- Text-to-Speech (el tutor te responde con voz) ---
# Requiere: pip install pyttsx3
# TTS_ENABLED=false
# TTS_RATE=170               # Velocidad de la voz (palabras por minuto)

# --- App ---
# DEFAULT_LEVEL=intermediate  # beginner, intermediate, advanced
